{
  "name": "@stoop/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CDK StoopStack: KMS keys, DynamoDB table, Vault Lambda, Step Functions saga + SQS job queue, host role.",
  "scripts": {
    "synth": "cdk synth --profile stoop",
    "deploy": "cdk deploy --profile stoop --require-approval never --outputs-file outputs.json",
    "destroy": "cdk destroy --profile stoop --force",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
