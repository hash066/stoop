# Copy to .env (never commit .env). Real secrets live in AWS Secrets Manager.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID_NEGOTIATOR=us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID_VISION=us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID_BUYERBOT=us.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID_PLANNER=us.amazon.nova-2-lite-v1:0
# Set to "mock" to run fully offline with deterministic fallbacks
LLM_MODE=bedrock
# Payment processor adapter: sandbox | stripe-test
PSP=sandbox
# Ring Developer Playground access token (30-minute lifetime)
RING_ACCESS_TOKEN=
# HMAC key for webhook verification (Ring onboarding key in prod; our simulator key locally)
RING_WEBHOOK_HMAC_KEY=
# Local-only MAC key for capability tokens (KMS GenerateMac in AWS)
LOCAL_TOKEN_MAC_KEY=dev-only-change-me
