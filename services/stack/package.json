{
  "name": "@stoop/stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local composition of every Stoop service behind one HTTP server (the AWS deployment splits these into Lambdas / AgentCore / Step Functions).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "vitest run --testTimeout=20000",
    "typecheck": "tsc -p tsconfig.json",
    "serve": "tsx src/serve.ts",
    "e2e": "tsx e2e/real-flow.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@stoop/agents": "workspace:*",
    "@stoop/mcp-server": "workspace:*",
    "@stoop/policy": "workspace:*",
    "@stoop/ring-bridge": "workspace:*",
    "@stoop/settlement": "workspace:*",
    "@stoop/shared": "workspace:*",
    "@stoop/verifier": "workspace:*",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-express-adapter": "^2.14.0",
    "ask-sdk-model": "^1.86.0",
    "hono": "^4.13.13",
    "proof-of-handoff": "workspace:*",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
